  period_month Int
  base_salary  Float?       @default(0)
  bonuses      Float?       @default(0)
  deductions   Float?       @default(0)
  net_salary   Float
  status       String?      @default("draft")
  payment_date String?
  company_id   String?
  created_at   String?      @default("datetime('now')")
  updated_at   String?      @default("datetime('now')")
  hr_employees hr_employees @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction) @ignore

