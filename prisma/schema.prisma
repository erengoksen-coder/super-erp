/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model general_ledger {
  id                    String @id
  account_id            String
  entry_date            String
  journal_entry_id      String
  journal_entry_line_id String
  debit                 Float?              @default(0)
  credit                Float?              @default(0)
  balance               Float?              @default(0)
  description           String?
  reference_type        String?
  reference_id          String?
  created_at            String?             @default("CURRENT_TIMESTAMP")
  updated_at            String?
  deleted_at            String?
  company_id            String?             @default("company_default")
  branch_id             String?             @default("branch_default")
  journal_entry_lines   journal_entry_lines @relation(fields: [journal_entry_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_entries       journal_entries     @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chart_of_accounts     chart_of_accounts   @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entry_date], map: "idx_general_ledger_date")
  @@index([account_id], map: "idx_general_ledger_account")
}

