/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model invoice_items {
  id          String @id
  invoice_id  String
  product_id  String
  quantity    Int
  unit_price  Float?   @default(0)
  total_price Float?   @default(0)
  notes       String?
  created_at  String?  @default("CURRENT_TIMESTAMP")
  deleted_at  String?
  company_id  String?  @default("company_default")
  branch_id   String?  @default("branch_default")
  products    products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices    invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model invoices {
  id                 String @id
  invoice_number     String           @unique(map: "sqlite_autoindex_invoices_2")
  shipment_id        String?
  customer_id        String
  invoice_date       String
  type               String?          @default("sale")
  status             String?          @default("issued")
  total_amount       Float?           @default(0)
  tax_rate           Float?           @default(0)
  tax_amount         Float?           @default(0)
  final_amount       Float?           @default(0)
  notes              String?
  created_at         String?          @default("CURRENT_TIMESTAMP")
  updated_at         String?          @default("CURRENT_TIMESTAMP")
  deleted_at         String?
  discount_rate      Float?           @default(0)
  discount_amount    Float?           @default(0)
  document_kind      String?
  due_date           String?
  payment_terms_days Int?             @default(0)
  company_id         String?          @default("company_default")
  branch_id          String?          @default("branch_default")
  e_invoice_logs     e_invoice_logs[] @ignore
  invoice_items      invoice_items[]  @ignore
  accounts           accounts         @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipments          shipments?       @relation(fields: [shipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments           payments[]       @ignore
}

model journal_entries {
  id                  String @id
  entry_number        String                @unique(map: "sqlite_autoindex_journal_entries_2")
  entry_date          String
  description         String?
  reference_type      String?
  reference_id        String?
  total_debit         Float?                @default(0)
