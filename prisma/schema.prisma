/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model direct_messages {
  id                                        String @id
  from_user_id                              String
  to_user_id                                String
  body                                      String
  read_at                                   String?
  created_at                                String? @default("CURRENT_TIMESTAMP")
  company_id                                String? @default("company_default")
  branch_id                                 String? @default("branch_default")
  users_direct_messages_to_user_idTousers   users   @relation("direct_messages_to_user_idTousers", fields: [to_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_direct_messages_from_user_idTousers users   @relation("direct_messages_from_user_idTousers", fields: [from_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_direct_messages_created_at")
  @@index([from_user_id, to_user_id], map: "idx_direct_messages_from_to")
}

