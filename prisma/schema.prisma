  company_id                  String?                       @default("company_default")
  branch_id                   String?                       @default("branch_default")
  production_order_operations production_order_operations[]
  production_order_times      production_order_times[]
}

model work_order_operations {
  id            String @id
  work_order_id String
  station       String
  status        String?     @default("pending")
  sequence      Int?        @default(0)
  started_at    String?
  completed_at  String?
  notes         String?
  created_at    String?     @default("CURRENT_TIMESTAMP")
  updated_at    String?     @default("CURRENT_TIMESTAMP")
  work_orders   work_orders @relation(fields: [work_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([work_order_id, station], map: "sqlite_autoindex_work_order_operations_2")
}

model work_orders {
  id                    String @id
  production_order_id   String                  @unique(map: "sqlite_autoindex_work_orders_3")
  work_order_number     String                  @unique(map: "sqlite_autoindex_work_orders_2")
  status                String?                 @default("open")
  planned_start_date    String?
  planned_end_date      String?
  notes                 String?
  company_id            String?                 @default("company_default")
  branch_id             String?                 @default("branch_default")
  created_at            String?                 @default("CURRENT_TIMESTAMP")
  updated_at            String?                 @default("CURRENT_TIMESTAMP")
  deleted_at            String?
  work_order_operations work_order_operations[]
  production_orders     production_orders       @relation(fields: [production_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
