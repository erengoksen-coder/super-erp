}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model bom {
  id                String @id
  version_id        String?
  product_id        String
  material_id       String
  parent_id         String?
  quantity_required Float
  fire_percentage   Float?    @default(0)
  created_at        String?   @default("CURRENT_TIMESTAMP")
  updated_at        String?   @default("CURRENT_TIMESTAMP")
  deleted_at        String?
  waste_percentage  Float?    @default(0)
  unit              String?
  company_id        String?   @default("company_default")
  branch_id         String?   @default("branch_default")
  materials         materials @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products          products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([version_id, product_id, material_id, parent_id], map: "uniq_bom_version_item")
  @@index([material_id], map: "idx_bom_material_id")
  @@index([product_id], map: "idx_bom_product_id")
  @@index([version_id], map: "idx_bom_version_id")
  @@index([parent_id], map: "idx_bom_parent_id")
}

model bom_versions {
  id              String @id
  product_id      String
  version_no      Int
  effective_date  String
  revision_reason String?
  is_active       Int?     @default(1)
  created_at      String?  @default("CURRENT_TIMESTAMP")
  updated_at      String?  @default("CURRENT_TIMESTAMP")
  deleted_at      String?
  company_id      String?  @default("company_default")
  branch_id       String?  @default("branch_default")
  products        products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, version_no], map: "sqlite_autoindex_bom_versions_2")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model branches {
  id         String @id
  company_id String
  name       String
  created_at String? @default("CURRENT_TIMESTAMP")
  updated_at String? @default("CURRENT_TIMESTAMP")
}

