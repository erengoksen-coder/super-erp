  period          String
  category        String
  budgeted_amount Float   @default(0)
  created_at      String? @default("CURRENT_TIMESTAMP")

  @@index([company_id, period], map: "idx_budgets_company_period")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model cash_boxes {
  id         String @id
  name       String
  currency   String?    @default("TRY")
  balance    Float?     @default(0)
  company_id String?    @default("company_default")
  branch_id  String?    @default("branch_default")
  created_at String?    @default("CURRENT_TIMESTAMP")
  updated_at String?    @default("CURRENT_TIMESTAMP")
  deleted_at String?
  payments   payments[]
}

model chart_of_accounts {
  id                      String @id
  code                    String                @unique(map: "sqlite_autoindex_chart_of_accounts_2")
  name                    String
  account_type            String
  parent_id               String?
  balance                 Float?                @default(0)
  is_active               Int?                  @default(1)
  created_at              String?               @default("CURRENT_TIMESTAMP")
  updated_at              String?               @default("CURRENT_TIMESTAMP")
  type                    String?
  deleted_at              String?
  company_id              String?               @default("company_default")
  branch_id               String?               @default("branch_default")
  chart_of_accounts       chart_of_accounts?    @relation("chart_of_accountsTochart_of_accounts", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_chart_of_accounts chart_of_accounts[]   @relation("chart_of_accountsTochart_of_accounts")
  general_ledger          general_ledger[]      @ignore
  journal_entry_lines     journal_entry_lines[] @ignore

  @@index([code], map: "idx_chart_of_accounts_code")
}

