generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model app_meta {
  key   String @id
  value String?

  @@map("_app_meta")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model test {
  val String?

  @@map("_test")
  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model account_transactions {
  id               String @id
  account_id       String
  transaction_type String
  amount           Float
  reference_type   String?
  reference_id     String?
  description      String?
  created_at       String?  @default("CURRENT_TIMESTAMP")
  company_id       String?  @default("company_default")
  branch_id        String?  @default("branch_default")
  deleted_at       String?
  accounts         accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, created_at], map: "idx_account_transactions_account")
  @@index([account_id], map: "idx_account_transactions_account_id")
}

model accounts {
  id                      String @id
  code                    String                  @unique(map: "sqlite_autoindex_accounts_2")
  name                    String
  type                    String                  @default("customer")
  tax_number              String?
  phone                   String?
  email                   String?
  address                 String?
  balance                 Float?                  @default(0)
  risk_limit              Float?                  @default(0)
  discount_rate           Float?                  @default(0)
  authorized_person_name  String?
  authorized_person_phone String?
  is_approved             Int?                    @default(1)
  company_id              String?                 @default("company_default")
  branch_id               String?                 @default("branch_default")
  created_at              String?                 @default("CURRENT_TIMESTAMP")
  updated_at              String?                 @default("CURRENT_TIMESTAMP")
  deleted_at              String?
  created_by              String?
  updated_by              String?
  account_transactions    account_transactions[]  @ignore
  invoices                invoices[]
  material_reservations   material_reservations[] @ignore
  payments                payments[]              @ignore
  purchase_orders         purchase_orders[]
  quotations              quotations[]
  sales_orders            sales_orders[]
  shipments               shipments[]
  waybills                waybills[]

  @@index([code], map: "idx_accounts_code")
  @@index([type], map: "idx_accounts_type")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model actual_expenses {
  id            String @id
  company_id    String
  period        String
  category      String
  actual_amount Float   @default(0)
  created_at    String? @default("CURRENT_TIMESTAMP")

  @@index([company_id, period], map: "idx_actual_expenses_company_period")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model announcements {
  id              String @id
  title           String
  content         String?
  target_audience String? @default("all")
  priority        String? @default("normal")
  valid_until     String?
  company_id      String?
  created_at      String? @default("datetime('now')")
}

model api_tokens {
  id              String @id
  name            String
  token           String  @unique(map: "sqlite_autoindex_api_tokens_2")
  last_used_at    String?
  is_active       Int?    @default(1)
  user_id         String?
  scopes          String?
  ip_restrictions String?
  expires_at      String?
  company_id      String? @default("company_default")
  branch_id       String? @default("branch_default")
  created_at      String? @default("CURRENT_TIMESTAMP")
  updated_at      String? @default("CURRENT_TIMESTAMP")
  users           users?  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model app_settings {
  id            String @id
  setting_key   String  @unique(map: "sqlite_autoindex_app_settings_2")
  setting_value String?
  updated_at    String? @default("datetime('now')")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model approval_requests {
  id               String @id
  document_type    String
  document_id      String
  requester_id     String
  approver_role_id String?
  approver_id      String?
  status           String? @default("pending")
  amount           Float?  @default(0)
  notes            String?
  rejection_reason String?
  company_id       String? @default("company_default")
  branch_id        String? @default("branch_default")
  created_at       String? @default("datetime('now')")
  updated_at       String? @default("datetime('now')")
  deleted_at       String?

  @@index([status], map: "idx_approval_requests_status")
  @@index([document_type, document_id], map: "idx_approval_requests_doc")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model approval_rules {
  id               String @id
  document_type    String
  min_amount       Float?  @default(0)
  max_amount       Float?
  approver_role_id String
  is_active        Int?    @default(1)
  company_id       String? @default("company_default")
  branch_id        String? @default("branch_default")
  created_at       String? @default("datetime('now')")
  updated_at       String? @default("datetime('now')")
  deleted_at       String?

  @@index([document_type], map: "idx_approval_rules_doc_type")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model audit_logs {
  id          String @id
  table_name  String
  action      String
  record_id   String?
  user_id     String?
  company_id  String? @default("company_default")
  branch_id   String? @default("branch_default")
  before_data String?
  after_data  String?
  created_at  String? @default("CURRENT_TIMESTAMP")
  old_data    String?
  new_data    String?
  ip_address  String?
  action_type String?
  entity_name String?
  entity_id   String?
  description String?
  user_agent  String?
  deleted_at  String?

  @@index([user_id], map: "idx_audit_logs_user_id")
  @@index([entity_name, entity_id], map: "idx_audit_logs_entity")
  @@index([company_id, branch_id], map: "idx_audit_logs_company_branch")
  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([table_name, record_id], map: "idx_audit_logs_table_record")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model banks {
  id         String @id
  name       String
  iban       String?
  account_no String?
  currency   String?    @default("TRY")
  balance    Float?     @default(0)
  company_id String?    @default("company_default")
  branch_id  String?    @default("branch_default")
  created_at String?    @default("CURRENT_TIMESTAMP")
  updated_at String?    @default("CURRENT_TIMESTAMP")
  deleted_at String?
