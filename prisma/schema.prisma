  return_date           String
  status                String                  @default("draft")
  total_amount          Float?                  @default(0)
  notes                 String?
  shipment_id           String?
  invoice_id            String?
  company_id            String?                 @default("company_default")
  branch_id             String?                 @default("branch_default")
  created_at            String?                 @default("datetime('now')")
  updated_at            String?                 @default("datetime('now')")
  deleted_at            String?
