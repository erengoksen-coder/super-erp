{
  "name": "super-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_DISABLE_TURBO=1 node server-https.js",
    "dev:https": "cross-env NEXT_DISABLE_TURBO=1 node server-https.js",
    "dev:simple": "next dev -H 0.0.0.0",
    "dev:clean": "rm -rf .next .turbo && next dev -H 0.0.0.0",
