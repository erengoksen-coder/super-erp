    "better-sqlite3": "^12.5.0",
    "canvg": "^4.0.3",
    "core-js": "^3.47.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.12.7",
    "selfsigned": "^2.1.1",
    "swr": "^2.3.8",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
