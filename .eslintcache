23\n  68 |\n  69 |     const timeAgo = (d: string) => {\n> 70 |         const diff = (Date.now() - new Date(d).getTime()) / 1000\n     |                       ^^^^^^^^^^ Cannot call impure function\n  71 |         if (diff < 60) return 'Az önce'\n  72 |         if (diff < 3600) return `${Math.floor(diff / 60)} dk`\n  73 |         if (diff < 86400) return `${Math.floor(diff / 3600)} saat`","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\super-erp\\components\\OfflineBanner.tsx:50:5\n  48 |     }\n  49 |     const initiallyOffline = !window.navigator.onLine\n> 50 |     setIsOffline(initiallyOffline)\n     |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  51 |     window.addEventListener('offline', handleOffline)\n  52 |     window.addEventListener('online', handleOnline)\n  53 |     return () => {","'status' is defined but never used.","'priorityColors' is assigned a value but never used.","'className' is defined but never used.","'ClipboardCheck' is defined but never used.","'recentPaths' is assigned a value but never used.","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\super-erp\\components\\Sidebar.tsx:336:7\n  334 |       const parsedRecent = rawRecent ? JSON.parse(rawRecent) : []\n  335 |       const list = Array.isArray(parsedRecent) ? parsedRecent.slice(0, MAX_RECENT) : []\n> 336 |       setRecentPaths(list.map((p: { path: string; label?: string }) => ({\n      |       ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  337 |         path: p.path,\n  338 |         label: getLabelForPath(p.path),\n  339 |       })))","The 'permissions' logical expression could make the dependencies of useMemo Hook (at line 372) change on every render. Move it inside the useMemo callback. Alternatively, wrap the initialization of 'permissions' in its own useMemo() Hook.","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\super-erp\\components\\Sidebar.tsx:380:5\n  378 |     )\n  379 |     if (!parent) return\n> 380 |     setExpandedMenus((prev) => (prev[parent.name] ? prev : { [parent.name]: true }))\n      |     ^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  381 |   }, [pathname])\n  382 |\n  383 |   useEffect(() => {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\super-erp\\components\\Sidebar.tsx:386:5\n  384 |     if (!pathname || pathname === ROUTES.LOGIN || pathname === ROUTES.REGISTER || pathname === '/') return\n  385 |     const label = getLabelForPath(pathname)\n> 386 |     setRecentPaths((prev) => {\n      |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  387 |       const next = [{ path: pathname, label }, ...prev.filter((p) => p.path !== pathname)].slice(0, MAX_RECENT)\n  388 |       try {\n  389 |         window.localStorage.setItem(RECENT_KEY, JSON.stringify(next))","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\super-erp\\components\\Sidebar.tsx:400:7\n  398 |   useEffect(() => {\n  399 |     if (debouncedSearchTerm.trim().length < 2) {\n> 400 |       setGlobalSearchData(null)\n      |       ^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  401 |       return\n  402 |     }\n  403 |     let cancelled = false","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\super-erp\\components\\SidebarContext.tsx:21:28\n  19 |     try {\n  20 |       const stored = localStorage.getItem(STORAGE_KEY)\n> 21 |       if (stored !== null) setCollapsedState(stored === 'true')\n     |                            ^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  22 |     } catch {}\n  23 |   }, [])\n  24 |","'VariantProps' is defined but never used.","react-hooks/rules-of-hooks","React Hook \"React.useId\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","MemberExpression","react-hooks/incompatible-library","Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\nC:\\super-erp\\components\\VirtualTableBody.tsx:41:23\n  39 | }: VirtualTableBodyProps<T>) {\n  40 |   const parentRef = useRef<HTMLDivElement>(null)\n> 41 |   const virtualizer = useVirtualizer({\n     |                       ^^^^^^^^^^^^^^ TanStack Virtual's `useVirtualizer()` API returns functions that cannot be memoized safely\n  42 |     count: rows.length,\n  43 |     getScrollElement: () => parentRef.current,\n  44 |     estimateSize: () => estimateSize ?? rowHeight,","Unused eslint-disable directive (no problems were reported).",{"range":"8889","text":"8584"},"'ae' is assigned a value but never used.",["8890"],"'af' is assigned a value but never used.",["8891"],"'ag' is assigned a value but never used.",["8892"],["8893"],["8894"],"'test' is defined but never used.",["8895","8896"],["8897","8898"],["8899","8900"],"'isFormData' is assigned a value but never used.",["8901","8902"],["8903","8904"],["8905","8906"],["8907","8908"],["8909","8910"],["8911","8912"],["8913","8914"],"'value' is defined but never used.",["8915","8916"],["8917","8918"],["8919","8920"],["8921","8922"],["8923","8924"],["8925","8926"],["8927","8928"],["8929","8930"],["8931","8932"],["8933","8934"],["8935","8936"],["8937","8938"],["8939","8940"],["8941","8942"],["8943","8944"],["8945","8946"],["8947"],["8948","8949"],["8950","8951"],["8952","8953"],["8954","8955"],["8956","8957"],["8958","8959"],["8960","8961"],["8962","8963"],["8964","8965"],["8966","8967"],["8968","8969"],["8970","8971"],["8972","8973"],["8974","8975"],["8976","8977"],["8978","8979"],["8980","8981"],["8982","8983"],["8984","8985"],["8986","8987"],["8988","8989"],["8990","8991"],["8992","8993"],["8994","8995"],["8996","8997"],["8998","8999"],["9000","9001"],["9002","9003"],["9004","9005"],["9006","9007"],["9008","9009"],["9010","9011"],["9012","9013"],["901