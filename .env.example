# Environment Variables
# JWT_SECRET zorunlu. Değiştirince sunucuyu yeniden başlatın (Windows: Ctrl+C sonra npm run dev).
JWT_SECRET=your-very-secure-random-jwt-secret-key-at-least-32-characters-long
DATABASE_URL=file:./database.db
# Docker production: DATABASE_PATH=/app/data/erp.db (compose ile otomatik)
NODE_ENV=production

# Opsiyonel - API hata logu dosyaya yazılsın (logs/api-error.log)
# LOG_TO_FILE=true

# Opsiyonel - İnternet erişimi (Ngrok)
# NGROK_AUTHTOKEN=ngrok-dashboard-dan-alinan-token
# APP_PUBLIC_URL=https://xxx.ngrok-free.dev

# Opsiyonel - E-posta (SMTP) - sipariş/sevkiyat/şifre sıfırlama bildirimleri
# Gmail için: docs/SMTP_GMAIL.md dosyasına bakın (Uygulama şifresi gerekli)
# ENABLE_EMAIL_NOTIFICATIONS=true
# Gmail SMTP örneği:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=your-email@gmail.com

# Opsiyonel - SMS
# SMS_API_URL=
# SMS_API_KEY=