# Environment Variables
# JWT_SECRET zorunlu. Değiştirince sunucuyu yeniden başlatın (Windows: Ctrl+C sonra npm run dev).
JWT_SECRET=your-very-secure-random-jwt-secret-key-at-least-32-characters-long
DATABASE_URL=file:./database.db

# Tek veritabanı: Uygulama data/erp.db kullanır. Aynı DB'yi paylaşmak için:
# - Tek sunucu çalıştırın (npm run dev); tüneli buna yönlendirin (örn. cloudflared --url http://localhost:3000).
# - İsterseniz mutlak yol ile aynı dosyayı iki process'te kullanın (önerilmez; tek sunucu tercih edin):
# DATABASE_PATH=C:/super-erp/data/erp.db
# Docker production: DATABASE_PATH=/app/data/erp.db (compose ile otomatik)
NODE_ENV=production

# Opsiyonel - API hata logu dosyaya yazılsın (logs/api-error.log)
# LOG_TO_FILE=true

# Opsiyonel - İnternet erişimi (Ngrok)
# NGROK_AUTHTOKEN=ngrok-dashboard-dan-alinan-token
# APP_PUBLIC_URL=https://xxx.ngrok-free.dev

# Opsiyonel - E-posta (SMTP) - sipariş/sevkiyat/şifre sıfırlama bildirimleri
# Gmail için: docs/SMTP_GMAIL.md dosyasına bakın (Uygulama şifresi gerekli)
# ENABLE_EMAIL_NOTIFICATIONS=true
# Gmail SMTP örneği:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=your-email@gmail.com

# Opsiyonel - SMS
# SMS_API_URL=
# SMS_API_KEY=

# Opsiyonel - RLS testleri (tests/rls/production-orders.test.ts)
# Supabase projesi + iki test kullanıcısı gerekir. Tanımlı değilse RLS testleri atlanır.
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# RLS_TEST_USER1_ID=uuid-user1
# RLS_TEST_USER2_ID=uuid-user2
# RLS_TEST_USER1_TOKEN=eyJ...   (user1 JWT, Supabase Auth veya login ile alınır)
# RLS_TEST_USER2_TOKEN=eyJ...   (user2 JWT)